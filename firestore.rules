rules_version = '2';

// Sikkerhetsregler for Planlegger.
// Kun e-postadressene i listen under får lese og skrive data.
// Bytt ut eksemplene med Google-kontoene til husstanden (små bokstaver).
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'din.epost@gmail.com',
          'partner.epost@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if isMember();
    }
  }
}
